<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only used for the "code was read" notification; the app never talks to the network. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />


    <!-- Android 11+ 需要显式声明才能查询/唤起待提取的目标应用 -->
    <queries>
        <package android:name="com.riotgames.mobile.leagueconnect" />
        <package android:name="com.valvesoftware.android.steam.community" />
        <package android:name="com.google.android.apps.authenticator2" />
        <package android:name="com.beemdevelopment.aegis" />
        <package android:name="com.azure.authenticator" />
        <package android:name="me.weishu.kernelsu" />
        <package android:name="com.topjohnwu.magisk" />
    </queries>

    <application
        android:allowBackup="false"
        android:description="@string/xposed_desc"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="otpauth" />
            </intent-filter>

            <!-- 分享纯文本 / 文件进来，直接走 ImportEngine -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- 用本应用打开备份文件（.json / .txt / .csv / .xml） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.EditEntryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.EditGroupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Manifest-declared so the answer still arrives while this app sits in the background
             and the system has frozen its process. A runtime receiver is not seen as live in that
             state, so the broadcast would be dropped. -->
        <receiver
            android:name=".ProbeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.blockman.totpull.action.RESULT" />
                <action android:name="io.blockman.totpull.action.READY" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
