<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      建议作用域：只放目标应用。
      早先这里还放了本应用自身，想让框架把模块注入自己的进程来「握手」；但 LSPosed 会明确拒绝
      「模块把自身加入作用域」（module cannot target itself），所以那条路在 LSPosed 上走不通。
      现在模块是否可用改由「探测是否收到目标应用的回应」判定，不需要自注入。
    -->
    <string-array name="xposedscope">
        <item>com.riotgames.mobile.leagueconnect</item>
        <item>com.valvesoftware.android.steam.community</item>
        <item>com.google.android.apps.authenticator2</item>
    </string-array>
</resources>
