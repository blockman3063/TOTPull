<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include
                android:id="@+id/page_codes"
                layout="@layout/page_codes"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/page_info"
                layout="@layout/page_info"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- 底栏：胶囊指示器 + 图标在上、文字在下，参考 LSPosed / ColorDuo 的做法 -->
        <LinearLayout
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@color/nav_bg"
            android:elevation="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/nav_codes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/nav_codes_pill"
                    android:layout_width="54dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_nav_pill">

                    <ImageView
                        android:id="@+id/nav_codes_icon"
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/nav_codes"
                        android:src="@drawable/ic_nav_codes"
                        android:tint="@color/nav_item_active" />
                </FrameLayout>

                <TextView
                    android:id="@+id/nav_codes_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_codes"
                    android:textColor="@color/nav_item_active"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_info"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/nav_info_pill"
                    android:layout_width="54dp"
                    android:layout_height="26dp">

                    <ImageView
                        android:id="@+id/nav_info_icon"
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/nav_info"
                        android:src="@drawable/ic_nav_info"
                        android:tint="@color/nav_item_inactive" />
                </FrameLayout>

                <TextView
                    android:id="@+id/nav_info_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_info"
                    android:textColor="@color/nav_item_inactive"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
